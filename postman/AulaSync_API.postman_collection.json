      "name": "0. Autenticación y Control de Acceso",
      "item": [
        {
          "name": "01. Login Admin Exitoso (200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Inicio de sesión exitoso y token generado\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.ok).to.eql(true);",
                  "    pm.expect(json.data.token).to.be.a('string');",
                  "    pm.collectionVariables.set(\"token\", json.data.token);",
                  "    pm.collectionVariables.set(\"adminToken\", json.data.token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@universidad.edu\",\n  \"password\": \"admin123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth_login.php", "host": ["{{baseUrl}}"], "path": ["api", "auth_login.php"] }
          }
